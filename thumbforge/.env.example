# Copiar a .env y completar. El archivo .env NUNCA se versiona ni entra a la imagen.
#   cp .env.example .env

# --- Datos de YouTube (M1 recolector) ---
# Consola de Google Cloud -> API y servicios -> YouTube Data API v3 -> Credenciales.
# Formato esperado: 39 caracteres, empieza con AIza
YOUTUBE_API_KEY=

# --- Modelo de vision y de texto (M2 anotador, M4 brief) ---
# Con una de las dos alcanza. Si estan las dos, manda TF_PROVEEDOR_LLM.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Cual usar para vision/texto: anthropic | openai
TF_PROVEEDOR_LLM=anthropic

# --- Generacion de imagen (M5, solo para las categorias que el perfil permita) ---
# Va por API a proposito: nada de difusion local, nada de GPU.
# Valores: openai | ninguno
TF_PROVEEDOR_IMAGEN=openai

# --- Mapeo de usuario para los volumenes (compose) ---
# En Linux/Mac:  echo "UID=$(id -u)" >> .env && echo "GID=$(id -g)" >> .env
UID=1000
GID=1000
