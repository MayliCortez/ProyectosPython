# ─── Núcleo ────────────────────────────────────────────────────────────────────
FACTORY_ENV=development
FACTORY_LOG_LEVEL=INFO
FACTORY_API_PORT=8000

# ─── Base de datos ─────────────────────────────────────────────────────────────
FACTORY_DATABASE_URL=postgresql+asyncpg://factory:factory@postgres:5432/factory
POSTGRES_USER=factory
POSTGRES_PASSWORD=factory
POSTGRES_DB=factory

# ─── Redis (cola, bus de eventos, caché) ───────────────────────────────────────
FACTORY_REDIS_URL=redis://redis:6379/0

# ─── Seguridad ─────────────────────────────────────────────────────────────────
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
FACTORY_JWT_SECRET=cambia-esto-en-produccion
FACTORY_JWT_TTL_MINUTES=720

# ─── Motor de IA ───────────────────────────────────────────────────────────────
# anthropic | fake   (fake = determinista, sin red, para pruebas y demos)
FACTORY_LLM_PROVIDER=fake
FACTORY_ANTHROPIC_API_KEY=
FACTORY_LLM_MODEL=claude-opus-5
FACTORY_LLM_EFFORT=high

# ─── Almacenamiento compatible con S3 ──────────────────────────────────────────
FACTORY_S3_ENDPOINT_URL=http://minio:9000
FACTORY_S3_BUCKET=factory-artifacts
FACTORY_S3_ACCESS_KEY=factoryadmin
FACTORY_S3_SECRET_KEY=factoryadmin
FACTORY_S3_REGION=us-east-1

# ─── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
