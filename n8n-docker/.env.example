# ============================================
# Configuracion de n8n - Community Edition
# Copia este archivo como .env y ajusta los valores
# ============================================

# --- PostgreSQL ---
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=CAMBIA_ESTA_PASSWORD
POSTGRES_DB=n8n_db

# --- n8n ---
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# --- Autenticacion de n8n ---
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CAMBIA_ESTA_PASSWORD

# --- Zona horaria ---
# Ajusta a tu zona horaria: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
GENERIC_TIMEZONE=America/Mexico_City
